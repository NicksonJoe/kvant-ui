"import { ArrowRight, Ellipsis, MessageCircle } from 'lucide-react';
import { Badge } from '../components/badge';
import { Button, IconButton } from '../components/button';
import { Avatar, Card, CardHeader } from '../components/card';

export function DealCard() {
  return (
    <Card className="w-100 max-w-full">
      <CardHeader
        title="Айдентика для пекарни"
        description="Пекарня «Хлебница» · до 30 октября"
        action={<IconButton aria-label="Действия со сделкой" size="sm" icon={<Ellipsis />} />}
      />
      <div className="flex items-center justify-between gap-2">
        <Badge tone="info">Переговоры</Badge>
        <h3 className="text-heading-xs font-semibold tabular-nums">1 284 900 ₽</h3>
      </div>
      <div className="flex items-center gap-3">
        <Avatar name="Анна Северова" />
        <div className="flex flex-col">
          <span className="text-label-md font-medium">Анна Северова</span>
          <span className="text-caption text-fg-3">Менеджер проекта</span>
        </div>
      </div>
      <div className="flex items-center justify-end gap-2">
        <Button variant="secondary" size="sm" leadingIcon={<MessageCircle />}>Написать</Button>
        <Button size="sm" trailingIcon={<ArrowRight />}>Открыть сделку</Button>
      </div>
    </Card>
  );
}
"
`;

