exports[`generateCode > prints «Форма входа» as a component with its imports 1`] = `
"import { Mail } from 'lucide-react';
import { Button, Card, CardHeader, Checkbox, Field, Input, Link, PasswordInput } from '@/kvant';

export function Block() {
  return (
    <Card padding="spacious" className="w-100 max-w-full">
      <CardHeader title="Вход в Норду" description="Рабочая почта и пароль от студии" />
      <Field label="Почта">
        <Input placeholder="name@studio.ru" prefix={<Mail />} />
      </Field>
      <Field label="Пароль">
        <PasswordInput placeholder="Не меньше 8 символов" />
      </Field>
      <div className="flex items-center justify-between gap-2">
        <Checkbox>Запомнить меня</Checkbox>
        <Link href="#">Забыли пароль?</Link>
      </div>
      <Button size="lg">Войти</Button>
    </Card>
  );
}
"
`;

