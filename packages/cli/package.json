{
  "name": "kvant-ui",
  "version": "0.1.1",
  "description": "Kvant UI: компоненты копируются в проект одной командой и дальше принадлежат проекту.",
  "type": "module",
  "bin": {
    "kvant-ui": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "registry": "node scripts/build-registry.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
