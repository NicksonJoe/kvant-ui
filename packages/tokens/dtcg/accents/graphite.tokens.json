{
  "$description": "Accent «graphite» (data-accent=\"graphite\"): \"light\" applies in both modes, \"dark\" overrides it in dark mode.",
  "light": {
    "tint": { "$type": "number", "hue": { "$value": 286 }, "strength": { "$value": 0.6 } },
    "color": {
      "$type": "color",
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.235, 0.006, 286] } },
      "accent-hover": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.006, 286] } },
      "accent-pressed": { "$value": { "colorSpace": "oklch", "components": [0.195, 0.006, 286] } },
      "accent-fg": { "$value": { "colorSpace": "oklch", "components": [0.99, 0, 0] } },
      "accent-soft": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.008, 286] } },
      "accent-soft-hover": { "$value": { "colorSpace": "oklch", "components": [0.935, 0.008, 286] } },
      "accent-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.517, 0.012, 286] } },
      "ring": { "$value": "{color.accent}" },
      "info": { "$value": { "colorSpace": "oklch", "components": [0.559, 0.146, 250] } },
      "info-fg": { "$value": { "colorSpace": "oklch", "components": [0.995, 0, 0] } },
      "info-soft": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.03, 250] } },
      "info-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.52, 0.137, 250] } },
      "success": {
        "$value": { "colorSpace": "oklch", "components": [0.544, 0.15, 150] },
        "$extensions": { "cloud.norda.kvant": { "hue": "success" } }
      },
      "danger": {
        "$value": { "colorSpace": "oklch", "components": [0.581, 0.15, 27] },
        "$extensions": { "cloud.norda.kvant": { "hue": "danger" } }
      },
      "danger-hover": {
        "$value": { "colorSpace": "oklch", "components": [0.541, 0.142, 27] },
        "$extensions": { "cloud.norda.kvant": { "hue": "danger" } }
      }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.925, 0.004, 286] } },
      "accent-hover": { "$value": { "colorSpace": "oklch", "components": [0.965, 0.003, 286] } },
      "accent-pressed": { "$value": { "colorSpace": "oklch", "components": [0.875, 0.004, 286] } },
      "accent-fg": { "$value": { "colorSpace": "oklch", "components": [0.205, 0.006, 286] } },
      "accent-soft": { "$value": { "colorSpace": "oklch", "components": [0.27, 0.008, 286] } },
      "accent-soft-hover": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.008, 286] } },
      "accent-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.012, 286] } },
      "info": { "$value": { "colorSpace": "oklch", "components": [0.524, 0.137, 250] } },
      "info-soft": { "$value": { "colorSpace": "oklch", "components": [0.27, 0.05, 250] } },
      "info-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.097, 250] } },
      "success": {
        "$value": { "colorSpace": "oklch", "components": [0.511, 0.15, 150] },
        "$extensions": { "cloud.norda.kvant": { "hue": "success" } }
      },
      "danger": {
        "$value": { "colorSpace": "oklch", "components": [0.547, 0.15, 27] },
        "$extensions": { "cloud.norda.kvant": { "hue": "danger" } }
      },
      "danger-hover": {
        "$value": { "colorSpace": "oklch", "components": [0.582, 0.15, 27] },
        "$extensions": { "cloud.norda.kvant": { "hue": "danger" } }
      }
    }
  }
}
