{
  "$description": "Accent «orchid» (data-accent=\"orchid\"): \"light\" applies in both modes, \"dark\" overrides it in dark mode.",
  "light": {
    "tint": { "$type": "number", "hue": { "$value": 330 }, "strength": { "$value": 0.9 } },
    "color": {
      "$type": "color",
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.583, 0.18, 342] } },
      "accent-hover": { "$value": { "colorSpace": "oklch", "components": [0.543, 0.17, 342] } },
      "accent-pressed": { "$value": { "colorSpace": "oklch", "components": [0.503, 0.156, 342] } },
      "accent-fg": { "$value": { "colorSpace": "oklch", "components": [0.995, 0, 0] } },
      "accent-soft": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.027, 342] } },
      "accent-soft-hover": { "$value": { "colorSpace": "oklch", "components": [0.935, 0.04, 342] } },
      "accent-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.537, 0.18, 342] } },
      "ring": { "$value": "{color.accent}" },
      "info": { "$value": { "colorSpace": "oklch", "components": [0.559, 0.146, 250] } },
      "info-fg": { "$value": { "colorSpace": "oklch", "components": [0.995, 0, 0] } },
      "info-soft": { "$value": { "colorSpace": "oklch", "components": [0.955, 0.03, 250] } },
      "info-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.52, 0.137, 250] } }
    }
  },
  "dark": {
    "color": {
      "$type": "color",
      "accent": { "$value": { "colorSpace": "oklch", "components": [0.548, 0.18, 342] } },
      "accent-hover": { "$value": { "colorSpace": "oklch", "components": [0.583, 0.18, 342] } },
      "accent-pressed": { "$value": { "colorSpace": "oklch", "components": [0.528, 0.173, 342] } },
      "accent-soft": { "$value": { "colorSpace": "oklch", "components": [0.27, 0.05, 342] } },
      "accent-soft-hover": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.06, 342] } },
      "accent-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.13, 342] } },
      "ring": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.13, 342] } },
      "info": { "$value": { "colorSpace": "oklch", "components": [0.524, 0.137, 250] } },
      "info-soft": { "$value": { "colorSpace": "oklch", "components": [0.27, 0.05, 250] } },
      "info-soft-fg": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.097, 250] } }
    }
  }
}
